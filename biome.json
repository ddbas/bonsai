{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.agents",
      "!.claude",
      "!.pi",
      "!.opencode",
      "!.codegraph",
      "!.lavish",
      "!.mise",
      "!openspec",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true,
      "proseWrap": "always"
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@bonsai/git": "core must not depend on adapters",
                  "@bonsai/tmux": "core must not depend on adapters",
                  "@bonsai/logging": "core must not depend on adapters",
                  "pino": "core must not import infrastructure",
                  "commander": "core must not import infrastructure"
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "core must not touch node APIs"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
