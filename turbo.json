{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "rspack.config.*", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["BS_BIN", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "//#lint": {
      "inputs": ["**/*.{ts,json,md}", "biome.json", "!openspec/**"]
    },
    "//#format:biome": {
      "inputs": ["**/*.{ts,json,md}", "biome.json", "!openspec/**"]
    },
    "ci": {
      "dependsOn": ["build", "test", "//#lint"]
    }
  }
}
