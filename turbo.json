{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["BS_BIN", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.agents/**",
        "!.claude/**",
        "!.pi/**",
        "!.opencode/**",
        "!.codegraph/**",
        "!.lavish/**",
        "!.mise/**",
        "!openspec/**"
      ]
    }
  }
}
